{
  "name": "deadlock-street-brawl-helper",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --mode electron",
    "dist": "npm run build:electron && electron-builder --publish never",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --check --cache --cache-location node_modules/.cache/prettier .",
    "check": "bash scripts/check.sh",
    "fetch-data": "node scripts/fetch-data.mjs --brawl",
    "fetch-data:abilities": "node scripts/fetch-data.mjs --brawl-abilities",
    "icon-index": "node scripts/build-icon-index.mjs",
    "brawl": "npx tsx scripts/brawl-cli.ts",
    "brawl:see": "npx tsx scripts/brawl-recognise.ts",
    "preview": "vite preview",
    "win:setup": "bash scripts/win/setup.sh",
    "win:sync": "bash scripts/win/sync.sh",
    "win:e2e": "bash scripts/win/run-e2e.sh",
    "win:dev": "bash scripts/win/run-dev.sh",
    "win:demo": "bash scripts/win/run-demo.sh"
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.1.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.7",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.deadlockstreetbrawl.helper",
    "productName": "Deadlock Street Brawl Helper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron-dist/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "extraMetadata": {
      "main": "electron-dist/main.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
